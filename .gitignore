# R session/user files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# renv managed libraries and staging
renv/library/
renv/staging/

# Runtime outputs
logs/*
results/*
plots/*

# Large raw/extracted data (keep folder structure, not contents)
data/raw_archives/*
data/extracted/*

# Keep .gitkeep placeholders for directory structure
!logs/.gitkeep
!plots/.gitkeep
!results/.gitkeep
!results/**/.gitkeep
!data/raw_archives/.gitkeep
!data/extracted/.gitkeep
!data/metadata/.gitkeep

# Keep repository templates/config/code tracked
!config/
!decisions/
!R/
!slurm/
!README.md
!config/samples.csv
